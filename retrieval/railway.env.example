# Set these as Railway service variables. This file contains no credentials.
# Build root: repository root. Healthcheck path in service settings: /health.
RAILWAY_DOCKERFILE_PATH=/retrieval/Dockerfile
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300
RETRIEVAL_BACKEND=moss
MOSS_INDEX_NAME=auditor-memory-v2
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
RETRIEVAL_API_KEY=
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api
CRS_USERNAME=
CRS_PASSWORD=
