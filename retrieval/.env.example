# Copy to retrieval/.env (gitignored). Credentials come from https://calhacks.crscreditapi.com/ (emailed on signup).
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api
CRS_USERNAME=
CRS_PASSWORD=''   # keep the single quotes: the password has $ & ! in it

# Moss (project credentials from the Moss Portal, https://usemoss.dev). Needed for A4, the Moss spike.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=auditor-memory-v2

# local = persistent lexical search without credentials; moss = real SDK search.
# With both Moss credentials present, the default is moss. A Moss failure never
# silently switches providers. /health and /stats identify the active provider.
RETRIEVAL_BACKEND=moss
RETRIEVAL_ENTITY=eo-festival-nyc
RETRIEVAL_DEFAULT_AS_OF=2026-07-31
# RETRIEVAL_DATA_DIR=.data
# RETRIEVAL_SEED_PATH=../datagen/seed.json

# Set a shared random token when exposing the service publicly, and set the
# same RETRIEVAL_API_KEY on Convex. Callers use Authorization: Bearer <token>.
RETRIEVAL_API_KEY=
