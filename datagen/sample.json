    "thresholdCents": 500000,
    "clauses": [
      { "id": "policy-1.0", "text": "The controller owns the books and signs each period close." },
      { "id": "policy-2.0", "text": "Systems of record: bank feed for cash, ledger for balances, signed contracts for amounts owed. When sources disagree, the proposal states which governs and why." },
      { "id": "policy-3.0", "text": "Periods close on human sign-off and are then locked; late items are booked in the current period with a reference." },
      { "id": "policy-4.3", "text": "A vendor bank-detail change holds payments to that vendor until callback verification is logged; the change is escalated the day it arrives." },
      { "id": "policy-5.1", "text": "Contractual fees and penalties the contract makes non-recoverable are expensed when certain, not carried as receivables." },
      { "id": "policy-6.1", "text": "Ticket sales are deferred until the event; gross charges to Stripe clearing; processing fees expensed when the payout settles." },
      { "id": "policy-6.2", "text": "Fixed sponsorship recognized ratably over the campaign; variable components when measurable; a mid-term amendment triggers a catch-up in the period signed." },
      { "id": "policy-7.1", "text": "Costs for services rendered are accrued in the period of service from the schedule, reversed when the invoice arrives." },
      { "id": "policy-8.0", "text": "Materiality is P&L impact (sum of revenue and expense lines). Under $5,000, the controls engine may post when every rule passes and a clause is cited. $5,000 or more, and any control exception, needs the controller." },
      { "id": "policy-8.1", "text": "No person or system approves an entry it proposed." },
      { "id": "policy-8.2", "text": "A human-decided precedent with matching scope, under threshold, is pre-approved and does not re-escalate." },
      { "id": "policy-9.0", "text": "Every decision records proposal, reviewer, rules run, citations verbatim, and outcome." }
    ]
  },
