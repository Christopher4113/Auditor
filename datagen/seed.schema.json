{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditor seed.json (interface 5, A -> C)",
  "description": "Loaded by convex/seed.ts (`pnpm seed`), whose validators are the source of truth; this file mirrors them. Money is integer cents; dates are YYYY-MM-DD; period keys are YYYY-MM. Bank amounts are signed, positive = money in. Planted breaks are marked on bank transactions via answerKey.txnId. sample.json is the 10-transaction hand-written sample C seeds from until A1 lands.",
  "type": "object",
  "required": ["seed", "entity", "accounts", "openingBalances", "periods", "bankTransactions", "stripePayouts", "contracts", "policyPack", "vendors", "answerKey", "fxRates"],
  "$defs": {
    "line": {
      "type": "object",
      "required": ["account", "debit", "credit"],
      "properties": { "account": { "type": "string" }, "debit": { "type": "integer" }, "credit": { "type": "integer" }, "memo": { "type": "string" } }
    },
    "clause": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" } } }
  },
  "properties": {
    "seed": { "type": "integer" },
    "entity": { "type": "string", "description": "e.g. eo-festival-nyc" },
    "accounts": {
      "type": "array",
      "items": { "type": "object", "required": ["code", "name", "type"], "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "type": { "enum": ["asset", "liability", "equity", "revenue", "expense"] } } }
    },
    "openingBalances": { "type": "array", "items": { "$ref": "#/$defs/line" }, "description": "as of the first period's start; debits must equal credits" },
    "periods": {
      "type": "array",
      "items": { "type": "object", "required": ["period", "start", "end"], "properties": { "period": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" } } }
    },
    "bankTransactions": {
      "type": "array",
      "items": { "type": "object", "required": ["txnId", "period", "date", "amount", "counterparty", "memo"], "properties": { "txnId": { "type": "string" }, "period": { "type": "string" }, "date": { "type": "string" }, "amount": { "type": "integer" }, "counterparty": { "type": "string" }, "memo": { "type": "string" } } }
    },
    "stripePayouts": {
      "type": "array",
      "description": "loaded as bankTransactions with source=stripe; amount is the net deposit",
      "items": { "type": "object", "required": ["txnId", "period", "date", "amount", "gross", "fees", "chargeCount"], "properties": { "txnId": { "type": "string" }, "period": { "type": "string" }, "date": { "type": "string" }, "amount": { "type": "integer" }, "gross": { "type": "integer" }, "fees": { "type": "integer" }, "chargeCount": { "type": "integer" } } }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "object", "required": ["contractId", "counterparty", "title", "clauses"], "properties": { "contractId": { "type": "string" }, "counterparty": { "type": "string" }, "title": { "type": "string" }, "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } } } }
    },
    "policyPack": {
      "type": "object",
      "required": ["jurisdiction", "currency", "thresholdCents", "clauses"],
      "properties": { "jurisdiction": { "type": "string" }, "currency": { "type": "string" }, "thresholdCents": { "type": "integer" }, "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } } }
    },
    "vendors": {
      "type": "array",
      "items": { "type": "object", "required": ["vendorId", "name", "bankAccountLast4", "crsTestIdentity"], "properties": { "vendorId": { "type": "string" }, "name": { "type": "string", "description": "must equal the bank counterparty string" }, "bankAccountLast4": { "type": "string" }, "crsTestIdentity": { "type": "string" }, "contractId": { "type": "string" } } }
    },
    "answerKey": {
      "type": "array",
      "items": { "type": "object", "required": ["breakNumber", "period", "title", "txnId", "expectedKind", "expectedLines"], "properties": { "breakNumber": { "type": "integer" }, "period": { "type": "string" }, "title": { "type": "string" }, "txnId": { "type": "string" }, "expectedKind": { "type": "string" }, "expectedLines": { "type": "array", "items": { "$ref": "#/$defs/line" } } } }
    },
    "fxRates": {
      "type": "array",
      "description": "empty for the USD entity",
      "items": { "type": "object", "required": ["period", "currency", "rateToUsd"], "properties": { "period": { "type": "string" }, "currency": { "type": "string" }, "rateToUsd": { "type": "number" } } }
    }
  }
}
