  "policyClauses": [
    {
      "id": "policy-1.0",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "1.0",
      "text": "The controller owns the books and signs each period close.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-2.0",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "2.0",
      "text": "The bank feed is the system of record for cash, the ledger for balances, and signed contracts for amounts owed. When sources disagree, the proposal states which governs and why.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-3.0",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "3.0",
      "text": "Periods close on human sign-off and are then locked. Late items are booked in the current period with a reference to the original period.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-4.3",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "4.3",
      "text": "A vendor bank-detail change holds payments to that vendor until callback verification is logged. The change is escalated the day it arrives.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-5.1",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "5.1",
      "text": "Where a contract makes a fee, penalty or deduction non-recoverable, the amount is expensed in the period it becomes certain. It is not carried as a receivable.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-6.1",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "6.1",
      "text": "Ticket sales are deferred until the event. Gross charges are recorded to Stripe clearing; processing fees are expensed when the payout settles.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-6.2",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "6.2",
      "text": "Fixed sponsorship is recognized ratably over the campaign. Variable components are recognized when measurable. A mid-term amendment triggers a catch-up in the period signed.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-7.1",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "7.1",
      "text": "Costs for services rendered are accrued in the period of service from the schedule and reversed when the invoice arrives.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-8.0",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "8.0",
      "text": "Materiality is P&L impact, the sum of revenue and expense lines. Under $5,000 the controls engine may post when every rule passes and a policy clause is cited. $5,000 or more, and any control exception, requires the controller.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-8.1",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "8.1",
      "text": "No person or system approves an entry it proposed.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-8.2",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "8.2",
      "text": "A human-decided precedent with matching scope, under threshold, is pre-approved and does not re-escalate.",
      "effectiveDate": "2026-07-01"
    },
    {
      "id": "policy-9.0",
      "entity": "eo-festival-nyc",
      "policyPackId": "policy-nyc-v1",
      "number": "9.0",
      "text": "Every decision records the proposal, reviewer, rules run, verbatim citations, and outcome.",
      "effectiveDate": "2026-07-01"
    }
  ],
