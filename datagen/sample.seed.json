      "clauses": [
        {
          "id": "northern-lines-2.1",
          "number": "2.1",
          "text": "The total artist fee is $120,000 for the September 19–20, 2026 festival.",
          "effectiveDate": "2026-07-01"
        },
        {
          "id": "northern-lines-3.1",
          "number": "3.1",
          "text": "Fifty percent of the artist fee ($60,000) is payable within 10 days of signing; the balance is due before performance.",
          "effectiveDate": "2026-07-01"
        },
        {
          "id": "northern-lines-7.2",
          "number": "7.2",
          "text": "If the artist cancels more than 30 days before the event, the deposit is refunded less a 15% administrative fee.",
