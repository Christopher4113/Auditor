      "signedDate": "2026-07-01",
      "startDate": "2026-07-01",
      "endDate": "2026-09-20",
      "clauses": [
        {
          "id": "brightwater-3.1",
          "number": "3.1",
          "text": "The sponsor will pay $50,000 on August 15, 2026 for a campaign running July 1 through September 20, 2026.",
          "effectiveDate": "2026-07-01"
        },
        {
          "id": "brightwater-amendment-1",
