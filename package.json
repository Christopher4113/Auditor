{
  "name": "auditor",
  "private": true,
  "scripts": {
    "dev:convex": "convex dev",
    "dev:web": "pnpm --filter web dev",
    "dev:retrieval": "cd retrieval && uv run --env-file .env uvicorn main:app --reload --port 8000",
    "codegen": "convex codegen",
    "typecheck": "tsc -p convex && pnpm --filter web exec tsc -b",
    "seed": "convex run seed:load \"$(cat ${SEED:-datagen/seed.json})\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@convex-dev/agent": "latest",
    "@convex-dev/workflow": "latest",
    "ai": "^7",
    "convex": "^1",
    "zod": "^4"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^2"
  }
}
